# Salin berkas ini jadi ".env" lalu isi nilai sungguhan di bawah.
# Jangan commit ".env" ke Git — hanya ".env.example" ini yang boleh.

# --- MySQL --------------------------------------------------------------
# Buat database + tabel lebih dulu dengan schema.sql (lihat README.md),
# lalu buat user aplikasi terpisah dari root (contoh SQL ada di schema.sql).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=coldroom
DB_USER=coldroom
DB_PASS=

# --- Broker MQTT ----------------------------------------------------------
# Broker yang sama dipakai dashboard, tapi di sini pakai port MQTT asli
# (TLS 8883), BUKAN port WebSocket (8884) yang dipakai browser.
MQTT_HOST=73ffe5ace0de41cfaac68f90275a934d.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=
MQTT_PASS=
MQTT_TOPIC=coldroom/+/telemetry

# Simpan paling cepat sekali per sekian detik per alat, kecuali saat status
# sensor berubah (itu selalu disimpan).
MQTT_MIN_INTERVAL=60

# --- HTTP API (dipakai tombol "Exporta CSV" di dashboard) -----------------
HTTP_PORT=8090
